# Build from the REPOSITORY ROOT (docker-compose.yml sets context: ..), so the image
# can include the analysis core next to backend/.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /repo/backend

COPY backend/requirements.txt ./requirements.txt
RUN pip install -r requirements.txt

# The API reads DETECTOR_VERSION from this file (it never imports it).
COPY analyze_pitch_timing.py /repo/
COPY backend/ /repo/backend/

RUN useradd --uid 10001 --create-home app \
    && mkdir -p /data/storage && chown app:app /data/storage
USER app

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
