# Copy to .env for local runs outside Docker. docker-compose.yml sets these itself.
DATABASE_URL=postgresql+psycopg://pitchlab:pitchlab@localhost:5432/pitchlab
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=524288000
ANALYZER=fake
FAKE_ANALYZER_SECONDS=2.0
JOB_MAX_ATTEMPTS=3
JOB_TIMEOUT_SECONDS=900
RETRY_BASE_SECONDS=2.0
RETRY_CAP_SECONDS=300
LOG_LEVEL=INFO
